{
  "name": "dota2skins-mod-manager",
  "productName": "Dota2skins-mod-manager",
  "version": "1.2.2",
  "description": "Desktop mod manager for Dota 2 — browse, install, toggle and preset 1040+ cosmetic mods from the Dota2skins catalog",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/start-electron.js",
    "clean": "rm -rf dist/builder-debug.yml dist/builder-effective-config.yaml dist/latest.yml dist/latest-linux.yml dist/linux-unpacked dist/win-unpacked",
    "dist": "npm run build:release",
    "build:win": "electron-builder --win --publish never && node scripts/generate-update-manifests.js",
    "build:linux": "electron-builder --linux --publish never && node scripts/generate-update-manifests.js",
    "build:release": "electron-builder --win --linux --publish never && node scripts/generate-update-manifests.js",
    "release:win": "npm run build:win",
    "release:linux": "npm run build:linux"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/artem-prime42/dota2skins-mod-manager.git"
  },
  "author": {
    "name": "Artem Ruban",
    "email": "tyzerbebra@gmail.com"
  },
  "license": "GPL-3.0",
  "homepage": "https://github.com/artem-prime42/dota2skins-mod-manager",
  "devDependencies": {
    "@vscode/test-electron": "^3.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.3.9",
    "vpk-tools": "^1.0.3"
  },
  "build": {
    "appId": "com.thefleece.dota2skinsmodmanager",
    "productName": "Dota2skins-mod-manager",
    "icon": "build/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Artem Ruban <tyzerbebra@gmail.com>",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dota2skins-mod-manager",
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "artem-prime42",
      "repo": "dota2skins-mod-manager",
      "releaseType": "release"
    }
  }
}
